module dcmi_out_fifo_v2 (
  Data,
  Reset,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Wnum,
  Rnum,
  Almost_Full,
  Q,
  Empty,
  Full
)
;
input [8:0] Data;
input Reset;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output [11:0] Wnum;
output [11:0] Rnum;
output Almost_Full;
output [8:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.dcmi_out_fifo_v2  fifo_inst (
    .Reset(Reset),
    .RdClk(RdClk),
    .WrClk(WrClk),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[8:0]),
    .Empty(Empty),
    .Full(Full),
    .Almost_Full(Almost_Full),
    .Wnum(Wnum[11:0]),
    .Rnum(Rnum[11:0]),
    .Q(Q[8:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* dcmi_out_fifo_v2 */
