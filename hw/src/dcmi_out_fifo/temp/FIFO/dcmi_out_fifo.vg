`pragma protect end_protected
module dcmi_out_fifo (
  Data,
  Reset,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Wnum,
  Q,
  Empty,
  Full
)
;
input [15:0] Data;
input Reset;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output [5:0] Wnum;
output [15:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.dcmi_out_fifo  fifo_inst (
    .RdClk(RdClk),
    .WrClk(WrClk),
    .Reset(Reset),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[15:0]),
    .Empty(Empty),
    .Full(Full),
    .Wnum(Wnum[5:0]),
    .Q(Q[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* dcmi_out_fifo */
