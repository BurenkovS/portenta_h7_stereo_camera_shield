`pragma protect end_protected
module small_pipe_comp_fifo (
  Data,
  Clk,
  WrEn,
  RdEn,
  Reset,
  Almost_Empty,
  Almost_Full,
  Q,
  Empty,
  Full
)
;
input [8:0] Data;
input Clk;
input WrEn;
input RdEn;
input Reset;
output Almost_Empty;
output Almost_Full;
output [8:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo_sc.small_pipe_comp_fifo  fifo_sc_inst (
    .Clk(Clk),
    .Reset(Reset),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[8:0]),
    .Full(Full),
    .Almost_Empty(Almost_Empty),
    .Almost_Full(Almost_Full),
    .Empty(Empty),
    .Q(Q[8:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* small_pipe_comp_fifo */
