`pragma protect end_protected
module collected_fifo (
  Data,
  Reset,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Rnum,
  Q,
  Empty,
  Full
)
;
input [8:0] Data;
input Reset;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output [10:0] Rnum;
output [8:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.collected_fifo  fifo_inst (
    .Reset(Reset),
    .RdClk(RdClk),
    .WrClk(WrClk),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[8:0]),
    .Empty(Empty),
    .Full(Full),
    .Rnum(Rnum[10:0]),
    .Q(Q[8:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* collected_fifo */
