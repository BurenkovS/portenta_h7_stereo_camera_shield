`pragma protect end_protected
module cam_line_fifo (
  Data,
  Reset,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Q,
  Empty,
  Full
)
;
input [8:0] Data;
input Reset;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output [8:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.cam_line_fifo  fifo_inst (
    .Reset(Reset),
    .RdClk(RdClk),
    .WrClk(WrClk),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[8:0]),
    .Empty(Empty),
    .Full(Full),
    .Q(Q[8:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* cam_line_fifo */
