#include "gamma_correction.h"
#include "math.h"

void build_gamma_table_float_optimized(uint8_t* table, float gamma) {
    float inverse_gamma = 1.0f / gamma;
    float scale = 255.0f;
    float inv_scale = 1.0f / 255.0f;

    for (int i = 0; i < 256; i++) {
        float normalized = (float)i * inv_scale;
        float corrected = powf(normalized, inverse_gamma);
        int result = (int)(corrected * scale + 0.5f);

        table[i] = (uint8_t)(result < 0 ? 0 : (result > 255 ? 255 : result));
    }
}

static uint8_t gamma_table[256];
