#include "gamma_correction.h"

void write_gamma(uint8_t offset, uint8_t value)
{
	float frac = (gammaFrac == 0) ? 0 : (100.0F/gammaFrac);
	float gamma = (float)gammaInt + frac;

	build_gamma_table_float_optimized(gamma_table, gamma);

	uint32_t* params_ptr = (uint32_t*)(GAMMA_TABLE_OFFSET);
	uint32_t i;
	for(i = 0; i < 256/4; ++i)
	{
		*(params_ptr+i) = (gamma_table[i+3] << 24) | (gamma_table[i+2] << 16) | (gamma_table[i+1] << 8) | gamma_table[i];
	}
}
